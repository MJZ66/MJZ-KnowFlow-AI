# Production — copy to .env and fill secrets. Never commit real values.

APP_ENV=production
SECRET_KEY=replace-with-random-secret-at-least-32-characters-long

ALLOWED_ORIGINS=https://your-domain.com
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=600
METRICS_ENABLED=true

TASK_BACKEND=celery
CELERY_WORKER_CONCURRENCY=4

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Retrieval quality (production defaults) ---
# Use real BGE embeddings; create NEW knowledge bases after switching from hash.
VECTOR_PROVIDER=chroma
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
# Optional: persist HuggingFace model cache (also set in docker-compose HF_HOME volume)
# HF_HOME=/app/.cache/huggingface
# Docker production build with BGE:
# INSTALL_BGE=true docker compose up --build -d backend celery-worker

HYBRID_SEARCH_ENABLED=true
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

# Optional second-stage reranking (needs extra memory)
RERANKER_ENABLED=false
RERANKER_PROVIDER=local_bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

LLM_API_KEY=
DEEPSEEK_API_KEY=

# Owner admin (idempotent on each deploy / container restart)
PROMOTE_USER_ON_START=true
PROMOTE_USER_EMAIL=2429448372@qq.com
PROMOTE_USER_USERNAME=MJZ
PROMOTE_USER_ROLE=admin
# PROMOTE_USER_PASSWORD=  # optional, server .env only
