# Production — copy to .env and fill secrets. Never commit real values.

APP_ENV=production
SECRET_KEY=replace-with-random-secret-at-least-32-characters-long

ALLOWED_ORIGINS=https://your-domain.com
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=600
METRICS_ENABLED=true

TASK_BACKEND=celery
CELERY_WORKER_CONCURRENCY=4

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

HYBRID_SEARCH_ENABLED=true
RERANKER_ENABLED=false
EMBEDDING_PROVIDER=hash
VECTOR_PROVIDER=chroma_hash

LLM_API_KEY=
DEEPSEEK_API_KEY=

# Owner admin (idempotent on each deploy / container restart)
PROMOTE_USER_ON_START=true
PROMOTE_USER_EMAIL=2429448372@qq.com
PROMOTE_USER_USERNAME=MJZ
PROMOTE_USER_ROLE=admin
# PROMOTE_USER_PASSWORD=  # optional, server .env only
