# ============================================
# KnowFlow AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ============================================
# Database
# ============================================
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow_secret
POSTGRES_DB=knowflow
POSTGRES_PORT=5432

# ============================================
# Redis
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Task queue (background | celery)
TASK_BACKEND=celery

# RAG query cache
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=300

# Prometheus metrics at GET /api/metrics
METRICS_ENABLED=true

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Upload security
MAX_UPLOAD_SIZE_MB=30
ALLOWED_FILE_EXTENSIONS=pdf,docx,md,txt

# ============================================
# ChromaDB
# ============================================
CHROMA_PORT=8001

# ============================================
# Backend
# ============================================
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_PORT=8000
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=30
APP_ENV=development
RUN_MIGRATIONS_ON_START=true

# ============================================
# LLM Provider — Qwen3 / OpenAI-Compatible
# ============================================
LLM_PROVIDER=qwen
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_qwen_api_key_here
LLM_MODEL=qwen-plus
LLM_STREAM=true

# ============================================
# Vector / Embedding (Phase 1)
# ============================================
VECTOR_PROVIDER=chroma_hash
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# ============================================
# Reranker (Phase 2) — default off
# ============================================
RERANKER_ENABLED=false
RERANKER_PROVIDER=none
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_TOP_N=5
RETRIEVAL_OVERSAMPLE=4

# ============================================
# Hybrid Search (Phase 3) — default off
# ============================================
HYBRID_SEARCH_ENABLED=false
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
KEYWORD_TOP_K=20
VECTOR_TOP_K=20

# ============================================
# DeepSeek (reserved — not default embedding)
# ============================================
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_VECTOR_INDEX_PREFIX=kb_

# ============================================
# Frontend
# ============================================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# Nginx (production only)
# ============================================
NGINX_PORT=80
